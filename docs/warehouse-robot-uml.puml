skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 65
skinparam ArrowColor #555555
skinparam classBackgroundColor White
skinparam classBorderColor #555555
hide empty members

package model #EFF6EB {
  class SimulationState <<final / read-only snapshot>> {
    - currentStep : int {readOnly}
    - grid : char[][] {readOnly}
    - pickupPoints : List<Position> {readOnly}
    - dropoffPoints : List<Position> {readOnly}
    - chargers : List<Position> {readOnly}
    - robots : List<RobotState> {readOnly}
    - tasks : List<TaskState> {readOnly}
    + getCurrentStep() : int
    + getRows() : int
    + getCols() : int
    + getCell(row : int, col : int) : char
    + getGrid() : char[][]
    + getPickupPoints() : List<Position>
    + getDropoffPoints() : List<Position>
    + getChargers() : List<Position>
    + getRobots() : List<RobotState>
    + getTasks() : List<TaskState>
  }
  class "SimulationState.RobotState" as RobotState <<static / final>> {
    - id : int {readOnly}
    - type : String {readOnly}
    - position : Position {readOnly}
    - battery : int {readOnly}
    - status : SimulationState.RobotStatus {readOnly}
    - currentTaskId : String {readOnly}
  }
  class "SimulationState.TaskState" as TaskState <<static / final>> {
    - id : String {readOnly}
    - pickupPosition : Position {readOnly}
    - deliveryPosition : Position {readOnly}
    - assignedRobotId : String {readOnly}
    - status : Task.Status {readOnly}
  }
  enum "SimulationState.RobotStatus" as RobotStatus {
    IDLE
    WAITING
    ASSIGNED
    IN_PROGRESS
    LOW_BATTERY
  }
  enum "Task.Status" as TaskStatus {
    PENDING
    ASSIGNED
    IN_PROGRESS
    COMPLETED
  }
  class Task {
    - status : Task.Status
    + getStatus() : Task.Status
    + setStatus(status : Task.Status) : void
  }
  class Position <<immutable value>> {
    - row : int {readOnly}
    - col : int {readOnly}
    + Position(row : int, col : int)
    + getRow() : int
    + getCol() : int
  }
}

package ui #FFF5E7 {
  class SimulationFrame {
    + requestTaskInput(initialValues : TaskInput) : TaskInput
  }
  class "SimulationFrame.TaskInput" as TaskInput <<static / final>> {
    - pickupRow : int {readOnly}
    - pickupCol : int {readOnly}
    - deliveryRow : int {readOnly}
    - deliveryCol : int {readOnly}
    + TaskInput(pickupRow : int, pickupCol : int, deliveryRow : int, deliveryCol : int)
    + getPickupRow() : int
    + getPickupCol() : int
    + getDeliveryRow() : int
    + getDeliveryCol() : int
  }
}

SimulationState --> "0..*" RobotState : robots {readOnly}
SimulationState --> "0..*" TaskState : tasks {readOnly}
SimulationState --> "0..*" Position : copied station coordinates
RobotState --> "0..1" Position : copied position
TaskState --> "0..1" Position : copied pickupPosition
TaskState --> "0..1" Position : copied deliveryPosition
RobotState --> "0..1" RobotStatus : status
TaskState --> "0..1" TaskStatus : status
Task --> "0..1" TaskStatus : status
SimulationFrame ..> TaskInput : creates / returns

note bottom of SimulationState
  Grid is copied on construction and getGrid().
  Station positions are copied; returned lists are unmodifiable.
  RobotState / TaskState copy positions and expose getters only.
  Snapshot IDs are values, not references to mutable Robot / Task.
end note
note bottom of RobotStatus
  Derived by Simulation.getRobotStatus().
  Robot has no persistent RobotStatus field.
end note
note bottom of TaskInput
  Input carries coordinates only.
  Application generates IDs and checks endpoint conflicts.
  TaskManager performs task ID / grid validation.
end note
legend bottom left
  Dotted names are actual nested Java types, not new top-level classes.
  {readOnly} marks final fields / read-only properties.
  Public constructors of snapshots are omitted for space.
  Null is allowed by snapshot constructors for positions / status.
  Current UI policy: endpoints of unfinished tasks cannot overlap.
  That policy is not a global constraint in TaskManager.
endlegend
@enduml
