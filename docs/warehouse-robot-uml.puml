package model #EFF6EB {
  class Warehouse {
    - grid : char[][]
    - rows : int
    - cols : int
    - pickupPoints : List<Position>
    - dropoffPoints : List<Position>
    - chargers : List<Position>
    + Warehouse(rows : int, cols : int)
    + getCell(row : int, col : int) : char
    + setCell(row : int, col : int, value : char) : void
    + addPickup(pos : Position) : void
    + addDropoff(pos : Position) : void
    + addCharger(pos : Position) : void
  }
  abstract class Robot {
    - id : int
    - position : Position
    - currentTask : Task
    - battery : int
    + {abstract} canCarry(weight : int) : boolean
    # {abstract} getMoveCost() : int
    + setTask(task : Task) : void
    + completeTask() : void
    + moveTo(newPosition : Position) : void
    + batteryLow() : boolean
    + recharge() : void
  }
  class StandardRobot {
    + {static} MAX_LOAD : int = 20
    + {static} STEP_COST : int = 1
    + StandardRobot(startPosition : Position)
    + StandardRobot(id : int, startPosition : Position)
    + canCarry(weight : int) : boolean
    # getMoveCost() : int
  }
  class HeavyRobot {
    + {static} MAX_LOAD : int = 50
    + {static} STEP_COST : int = 2
    + HeavyRobot(startPosition : Position)
    + canCarry(weight : int) : boolean
    # getMoveCost() : int
  }
  class Task {
    - id : String
    - pickupX : int
    - pickupY : int
    - deliveryX : int
    - deliveryY : int
    - assignedRobotId : String
    - status : Task.Status
    + Task(id : String, pickupX : int, pickupY : int, deliveryX : int, deliveryY : int)
  }
  class Position <<immutable value>> {
    - row : int {readOnly}
    - col : int {readOnly}
    + Position(row : int, col : int)
    + offset(dRow : int, dCol : int) : Position
    + equals(o : Object) : boolean
    + hashCode() : int
  }
  class SimulationState <<read-only snapshot>> {
    - currentStep : int
    - grid : char[][]
    - pickupPoints : List<Position>
    - dropoffPoints : List<Position>
    - chargers : List<Position>
    - robots : List<RobotState>
    - tasks : List<TaskState>
    + getGrid() : char[][]
    + getRobots() : List<RobotState>
    + getTasks() : List<TaskState>
  }
}

package ui #FFF5E7 {
  class SimulationFrame <<extends JFrame>> {
    - warehousePanel : WarehousePanel
    - statusPanel : StatusPanel
    - nextStepAction : Runnable
    - addTaskAction : Runnable
    - resetAction : Runnable
    + SimulationFrame()
    + render(state : SimulationState) : void
    + onNextStep(action : Runnable) : void
    + onAddTask(action : Runnable) : void
    + onReset(action : Runnable) : void
    + requestTaskInput(initialValues : TaskInput) : TaskInput
    + showError(message : String) : void
  }
  class WarehousePanel <<extends JPanel>> {
    - state : SimulationState
    - selectedRobotId : Integer
    - selectedTaskId : String
    + render(state : SimulationState) : void
    + setSelection(robotId : Integer, taskId : String) : void
    - paintWarehouse(graphics : Graphics, width : int, height : int) : void
  }
  class StatusPanel <<extends JPanel>> {
    - state : SimulationState
    - robotTable : JTable
    - taskTable : JTable
    - selectionChanged : BiConsumer<Integer, String>
    + render(state : SimulationState) : void
    + onSelectionChanged(callback : BiConsumer<Integer, String>) : void
  }
  class StatusColors <<package-private utility>> {
    ~ {static} task(status : Task.Status) : Color
    ~ {static} robot(status : SimulationState.RobotStatus) : Color
    ~ {static} background(color : Color) : Color
  }
}

Main ..> Application : creates / starts
Application "1" --> "0..1" Simulation : simulation
Application "1" --> "0..1" SimulationFrame : window / callback registration
Application ..> SimulationState : passes snapshot to render()

Simulation "1" *--> "1" TaskManager : taskManager
Simulation "1" *--> "1" PathPlanner : planner
Simulation --> "1" Warehouse : warehouse
Simulation --> "0..*" Robot : robots
Simulation ..> SimulationState : creates in getState()
TaskManager --> "1" Warehouse : validates cells
TaskManager --> "0..*" Task : tasks
TaskManager ..> Robot : assigns idle robot
PathPlanner --> "1" Warehouse : plans on grid (BFS)
PathPlanner ..> Position : path coordinates

Robot <|-- StandardRobot
Robot <|-- HeavyRobot
Robot --> "0..1" Position : position
Robot --> "0..1" Task : currentTask
Warehouse --> "0..*" Position : station coordinates

SimulationFrame "1" *--> "1" WarehousePanel
SimulationFrame "1" *--> "1" StatusPanel
SimulationFrame ..> SimulationState : renders
WarehousePanel --> "0..1" SimulationState : state
StatusPanel --> "0..1" SimulationState : state
WarehousePanel ..> StatusColors : colors
StatusPanel ..> StatusColors : colors
StatusPanel ..> WarehousePanel : selection callback\n(wired by SimulationFrame)

' Keep peers near one another without adding domain relationships.
Simulation -[hidden]right-> SimulationFrame
TaskManager -[hidden]right-> PathPlanner
StandardRobot -[hidden]right-> HeavyRobot

note bottom of TaskManager
  Insertion order; nearest eligible robot to pickup.
  Manhattan distance; ties follow robot list order.
  Skip busy / low-battery / positionless robots.
end note
note bottom of Task
  X = row; Y = col; zero-based.
  assignedRobotId stores String.valueOf(robot.getId()).
  The ID is not a direct Robot reference.
end note
note bottom of SimulationFrame
  Buttons call registered Runnable callbacks.
  No direct reference to Application or Simulation.
  Application updates Simulation and renders a new snapshot.
end note

legend bottom left
  Selected members only; routine accessors and JDK class boxes omitted.
  Solid arrow: reference; dashed arrow: use/create/callback dependency.
  Filled diamond: owned component; hollow triangle: inheritance.
  Nested snapshot/input types and enums: see the data detail diagram.
  Empty placeholders excluded: Movement, MovementManager,
  ConsoleInput, ConsoleOutput, FileManager. Tests are not shown.
endlegend
@enduml

